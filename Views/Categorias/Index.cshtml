@model IEnumerable<OficinaEF.Models.Categoria>

@{
    ViewData["Title"] = "Categorias";
}

<h1>Categorias</h1>

<div class="list-group">
@foreach (var cat in Model)
{
    <a asp-controller="Produtos" asp-action="Index" asp-route-categoriaId="@cat.Id" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
        <div>
            <strong>@cat.Nome</strong>
            <p class="mb-0 text-muted">@cat.Descricao</p>
        </div>
        <span class="badge bg-primary rounded-pill">Ver Produtos</span>
    </a>
    <a asp-action="Delete" asp-route-id="@cat.Id" class="btn btn-sm btn-danger ms-2">Excluir</a>
}
</div>