@model IEnumerable<OficinaEF.Models.Produto>

@{
    ViewData["Title"] = "Produtos";
}

<h1>Catálogo de Produtos</h1>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Nome</th>
            <th>Categoria</th>
            <th>Preço</th>
            <th>Estoque</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var produto in Model)
        {
            <tr>
                <td>@produto.Nome</td>
                <td>@produto.Categoria?.Nome</td>
                <td>@produto.Preco.ToString("C")</td>
                <td>@produto.Estoque</td>
                <td>
                    <a asp-action="Details" asp-route-id="@produto.Id" class="btn btn-sm btn-info">Detalhes</a>
                    <a asp-action="Delete" asp-route-id="@produto.Id" class="btn btn-sm btn-danger">Excluir</a>
                </td>
            </tr>
        }
    </tbody>
</table>