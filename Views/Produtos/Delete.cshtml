@model OficinaEF.Models.Produto

@{
    ViewData["Title"] = "Excluir Produto";
}

<h1>Excluir Produto</h1>
<h3>Tem certeza que deseja excluir este produto?</h3>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">Nome</dt>
        <dd class="col-sm-9">@Model.Nome</dd>

        <dt class="col-sm-3">Preço</dt>
        <dd class="col-sm-9">@Model.Preco.ToString("C")</dd>

        <dt class="col-sm-3">Categoria</dt>
        <dd class="col-sm-9">@Model.Categoria?.Nome</dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Excluir</button> |
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>